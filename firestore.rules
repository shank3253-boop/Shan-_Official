rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // User Validation
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'stats'])
        && data.keys().size() == 6
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 200
        && data.displayName is string && data.displayName.size() <= 100
        && data.createdAt is string && data.createdAt.size() <= 50
        && data.stats is map;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) 
        && (
          // Allow updating stats or profile info
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'stats'])
        );
      
      match /results/{resultId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(resultId); // Simplified validation for brevity, but should include full schema
      }
    }

    // MCQ Bank - Static for now, readable by signed in users
    match /mcqs/{mcqId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
    }

    // Intelligence Hot Topics
    match /intelligence_hot_topics/{topicId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /intelligence_subjective_vault/{qId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /question_submissions/{submissionId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }
  }
}
